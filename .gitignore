# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db

# --- Local, per-machine agent settings ---
# Skills are committed under .agents/ and symlinked; the settings file is
# one person's permission grants and does not belong to anyone else.
.claude/settings.local.json
.claude/settings.json
.cursor/settings.json

# --- Local config and secrets ---
# Never commit an endpoint, token, or model path that belongs to one machine.
.env
*.local.json
*.pem
*.key

# --- Benchmark-only opencode config ---
# XDG dirs, sqlite session store, warmed caches, and the agent pack copy.
# bench/isolate.sh recreates all of it on every run. The sqlite store holds
# full transcripts of real runs, so this must stay ignored.
bench/.xdg/

# --- Vendored fixture repositories ---
# Bare mirrors and warmed dependency caches: hundreds of MB to several GB.
# docs/FIXTURES.md records the mirror URL and base commit, which is the
# reproducible part; the git objects are not.
fixtures/

# --- Generated screening output ---
# Regenerated by `make screen`; the committed summary lives in docs/FIXTURES.md.
docs/SCREENING.md
docs/screening.json

# --- Run artifacts ---
# A results file worth keeping gets a name and a commit (see
# results-clean.jsonl). Whatever the last run happened to write does not.
runs/
results.jsonl
results-[0-9]*.jsonl
proxy*.jsonl
scoreboard.md

*.bak
